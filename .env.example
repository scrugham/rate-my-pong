# Local overrides (never commit real secrets)
DATABASE_URL=

# Write access (set real values in Vercel Production — keep them out of git)
# Comma-separated public IPs allowed to log / add players
WRITE_ALLOWED_IPS=
# Greater-area geo center + radius (miles). Leave empty locally unless testing geo.
WRITE_GEO_CENTER_LAT=
WRITE_GEO_CENTER_LON=
WRITE_GEO_RADIUS_MILES=
# Local only: allow writes without Vercel IP/geo headers (never set on Production)
WRITE_ACCESS_BYPASS=true
